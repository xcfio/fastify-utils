{
    "name": "fastify-utils",
    "version": "0.0.2",
    "description": "A collection of TypeScript utilities for building Fastify applications — error handling, schema validation formatting, and object serialization.",
    "author": "xcfio",
    "homepage": "https://github.com/xcfio/fastify-utils#readme",
    "type": "commonjs",
    "license": "MIT",
    "main": "./out/index.js",
    "types": "./out/index.d.ts",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "import": "./out/index.js",
            "require": "./out/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "tsc --noEmit"
    },
    "keywords": [
        "fastify",
        "fastify-plugin",
        "typescript",
        "error-handling",
        "validation",
        "typebox",
        "serialization"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/xcfio/fastify-utils"
    },
    "bugs": {
        "url": "https://github.com/xcfio/fastify-utils/issues",
        "email": "omarfaruksxp@gmail.com"
    },
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@fastify/error": ">=4.0.0 <5.0.0",
        "fastify": ">=5.0.0 <6.0.0",
        "typebox": ">=1.0.0 <2.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "typescript": "7.0.2"
    }
}
