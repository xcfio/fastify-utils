{
    "name": "fastify-utils",
    "version": "0.0.3",
    "description": "A collection of TypeScript utilities for building Fastify applications — error handling, schema validation formatting, and object serialization.",
    "author": "xcfio",
    "homepage": "https://github.com/xcfio/fastify-utils#readme",
    "type": "commonjs",
    "license": "MIT",
    "main": "./out/index.cjs",
    "types": "./out/index.d.cts",
    "exports": {
        ".": {
            "types": "./out/index.d.cts",
            "import": "./out/index.mjs",
            "require": "./out/index.cjs"
        }
    },
    "scripts": {
        "build": "tsdown --config=tsdown.config.mts",
        "dev": "tsdown --watch --config=tsdown.config.mts",
        "test": "tsc --noEmit && vitest run",
        "test:ui": "tsc --noEmit && vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "keywords": [
        "fastify",
        "fastify-plugin",
        "typescript",
        "error-handling",
        "validation",
        "typebox",
        "serialization"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/xcfio/fastify-utils",
        "directory": "packages/core"
    },
    "bugs": {
        "url": "https://github.com/xcfio/fastify-utils/issues",
        "email": "omarfaruksxp@gmail.com"
    },
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@fastify/error": ">=4.2.1",
        "fastify": ">=5.12.7",
        "typebox": ">=1.4.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/ui": "^5.0.5",
        "tsdown": "^0.23.1",
        "typescript": "7.0.2",
        "vitest": "^5.0.5"
    }
}
