{
    "$schema": "https://turborepo.dev/schema.json",
    "envMode": "loose",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"]
        },
        "test": {
            "dependsOn": ["^test"]
        },
        "test:ui": {
            "dependsOn": ["^test:ui"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "studio": {
            "cache": false,
            "persistent": true
        },
        "start": {
            "cache": false,
            "persistent": true
        }
    }
}
